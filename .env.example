# --- LLMs (format "provider:model") -------------------------------------
# Default: local Ollama, $0, no account needed.
LLM_BASIC=ollama:qwen2.5:3b
LLM_ADVANCED=ollama:qwen2.5:3b
# Free-tier cloud alternative (better quality): `uv sync --extra groq`, key from console.groq.com
# LLM_BASIC=groq:llama-3.1-8b-instant
# LLM_ADVANCED=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=
# Or Gemini free tier: `uv sync --extra gemini`, key from aistudio.google.com
# LLM_BASIC=google_genai:gemini-2.5-flash
# LLM_ADVANCED=google_genai:gemini-2.5-flash
# GOOGLE_API_KEY=

# --- Database (read-only role created by init/01-schema.sql) -------------
DB_HOST=localhost
DB_PORT=5437
DB_DATABASE=agent_db
DB_USER=agent_reader
DB_PASSWORD=reader_pass
